{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "guilty-party-remote-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.test.guiltyparty.app",
      "custom_domain": true
    }
  ],
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "ENVIRONMENT_PROFILE": "friends-mvp-development",
    "ALLOWED_ORIGINS": "https://host.test.guiltyparty.app,https://play.test.guiltyparty.app",
    "CLIENT_BUILD_POLICY_JSON": "{\"host_web\":{\"minimum_build_number\":1},\"companion_web\":{\"minimum_build_number\":1},\"companion_ios\":{\"minimum_build_number\":1},\"stage_webos\":{\"minimum_build_number\":1}}"
  },
  "ratelimits": [
    {
      "name": "SESSION_CREATE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SESSION_JOIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "STAGE_PAIRING_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSIONS",
        "class_name": "GameSession"
      },
      {
        "name": "STAGE_PAIRINGS",
        "class_name": "StagePairing"
      }
    ]
  },
  "exports": {
    "GameSession": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "StagePairing": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
