# Required: replace locally with a random value of at least 24 characters.
GP_HOST_TOKEN=replace-with-a-random-host-token

# Exact browser origins allowed to call the LAN server. Add the Mac's LAN URL
# when serving clients to other devices. Use `null` only for a trusted packaged
# client whose runtime sends that Origin value.
GP_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8081,http://localhost:8081

# Optional path for the synthetic append-only prototype journal.
# GP_JOURNAL_PATH=data/mvp-session.jsonl

# Optional: both values must be set together. Only loopback or private LAN IPs are accepted.
# GP_AI_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
# GP_AI_MODEL=operator-supplied-model-identifier
