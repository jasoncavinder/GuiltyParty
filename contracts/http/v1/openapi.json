{
  "openapi": "3.1.1",
  "info": {
    "title": "Guilty Party Control Plane",
    "version": "1.3.0",
    "description": "Protocol v1 HTTP operations. JSON Schema in contracts/control-plane/v1 is authoritative for payload shapes."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Synthetic local prototype example only"
    }
  ],
  "paths": {
    "/api/protocol": {
      "get": {
        "operationId": "getProtocolCompatibility",
        "summary": "Read non-private protocol compatibility information",
        "responses": {
          "200": {
            "description": "Supported protocol majors and features",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/CompatibilityResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "operationId": "createRemoteFriendsSession",
        "summary": "Create an invitation-only Remote Friends MVP session",
        "description": "Requires the operator-controlled Host bootstrap proof in Authorization. Browser authority is returned as a Secure, HttpOnly, SameSite=Strict cookie.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session, Host authority, and a short-lived pairing invitation were created",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/CreateSessionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/rehearsals/lifecycle/sessions": {
      "post": {
        "operationId": "createRemoteFriendsLifecycleRehearsalSession",
        "summary": "Create an operator-only short lifecycle rehearsal session",
        "description": "Development-profile verification surface. Requires the operator-controlled Host bootstrap proof and uses fixed 15-second invitation, 45-second active-session, and 30-second active-storage retention windows. It is not a client gameplay route and does not change ordinary session defaults.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Synthetic short-lived session and Host authority were created",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/CreateSessionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/join": {
      "post": {
        "operationId": "joinRemoteFriendsSession",
        "summary": "Pair a guest participant or Stage to a Remote Friends MVP session",
        "description": "Requires an opaque session identifier in X-GP-Session-ID and the short-lived invitation proof as Authorization: Pairing. This account-free test flow does not replace target account-backed pairing.",
        "parameters": [
          {
            "name": "X-GP-Session-ID",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/Identifier"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/JoinRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A short-lived authority was issued",
            "headers": {
              "Cache-Control": {
                "description": "Credential-bearing responses must not be cached.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/RemoteFriendsJoinResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "410": {
            "$ref": "#/components/responses/Problem"
          },
        "413": {
          "$ref": "#/components/responses/Problem"
        },
        "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/resume": {
      "post": {
        "operationId": "resumeRemoteFriendsParticipant",
        "summary": "Resume the same native participant endpoint after application restart",
        "description": "Requires the current rotating endpoint-bound credential as Authorization: Resume and a distinct, client-generated replacement in X-GP-Replacement-Resume. Both credentials are native-device-only and never placed in the request body, URL, logs, or browser storage. The client durably stages the replacement before sending; an exact retry of the same transition is safe, while a different replacement for a consumed credential revokes the family. A successful response confirms the replacement and issues memory-only access authority; private content remains unavailable until a fresh authorized WebSocket projection arrives.",
        "parameters": [
          {
            "name": "X-GP-Replacement-Resume",
            "in": "header",
            "required": true,
            "description": "A distinct high-entropy replacement credential generated and stored by the native client before the request. Exact retries must reuse the same value.",
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/ParticipantResumeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The existing participant endpoint was recovered and its staged resume authority confirmed",
            "headers": {
              "Cache-Control": {
                "description": "Credential-bearing responses must not be cached.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/RemoteNativeResumeResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "410": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/stage-pairings": {
      "post": {
        "operationId": "createPackagedStagePairing",
        "summary": "Create a short-lived packaged Stage pairing transaction",
        "description": "Requires the opaque packaged-app Origin value and no existing authority. The display code is non-secret; the polling secret remains only in Stage process memory.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/StagePairingCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A 120-second Stage pairing transaction was created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/StagePairingCreateResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/stage-pairings/{pairing_code}/approve": {
      "post": {
        "operationId": "approvePackagedStagePairing",
        "summary": "Approve a displayed Stage code for the Host's session",
        "parameters": [
          {
            "name": "pairing_code",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/StagePairingCode"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The Host approved this Stage pairing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/StagePairingApprovalResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "410": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/stage-pairings/{pairing_code}/redeem": {
      "post": {
        "operationId": "redeemPackagedStagePairing",
        "summary": "Poll or redeem an approved packaged Stage pairing",
        "description": "Requires Authorization: StagePairing with the high-entropy polling secret and the opaque packaged-app Origin. A pending response discloses no session context.",
        "parameters": [
          {
            "name": "pairing_code",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/StagePairingCode"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The approved Stage endpoint authority was issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/RemoteFriendsJoinResponse"
                }
              }
            }
          },
          "202": {
            "description": "The transaction is valid and awaiting Host approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/StagePairingPendingResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "410": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/websocket-tickets": {
      "post": {
        "operationId": "createPackagedStageWebSocketTicket",
        "summary": "Mint a short-lived, single-use packaged Stage WebSocket ticket",
        "description": "Requires packaged Stage bearer authority over HTTPS with the opaque file-scheme Origin value. The returned credential is offered as a secondary WebSocket subprotocol and is never placed in a URL or gameplay envelope.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "null"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A registered WebSocket ticket was issued",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/RealtimeConnectTicketResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/session/invitation": {
      "put": {
        "operationId": "rotateRemoteFriendsInvitation",
        "summary": "Rotate and reopen the current session pairing invitation",
        "responses": {
          "200": {
            "description": "A new short-lived pairing proof was issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/RotateInvitationResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      },
      "delete": {
        "operationId": "closeRemoteFriendsInvitation",
        "summary": "Close pairing for the current session",
        "responses": {
          "200": {
            "description": "Pairing was closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/SessionControlResponse"
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/session/end": {
      "post": {
        "operationId": "endRemoteFriendsSession",
        "summary": "End the current session and revoke all gameplay authority",
        "responses": {
          "200": {
            "description": "Session ended and deletion was scheduled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/SessionControlResponse"
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/session/endpoints": {
      "get": {
        "operationId": "listRemoteFriendsSessionEndpoints",
        "summary": "List the current Host's operational endpoint roster",
        "description": "Requires current browser Host authority. Returns endpoint identity and revocation metadata needed for Host support controls, never private gameplay content or credentials.",
        "responses": {
          "200": {
            "description": "Current session endpoint roster",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/SessionEndpointRosterResponse"
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/session/context": {
      "get": {
        "operationId": "getRemoteFriendsSessionContext",
        "summary": "Recover the current validated browser endpoint context",
        "description": "Requires current cookie authority and its exact browser origin. Returns no credential or gameplay projection.",
        "responses": {
          "200": {
            "description": "Current endpoint context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/SessionAuthorityContextResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/session/endpoints/{endpoint_id}/revoke": {
      "post": {
        "operationId": "revokeRemoteFriendsEndpoint",
        "summary": "Revoke one non-Host session endpoint",
        "parameters": [
          {
            "name": "endpoint_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/Identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Endpoint was revoked or was already revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/SessionControlResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Problem": {
        "description": "Safe RFC 9457 Problem Details response",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../../control-plane/v1/control-plane.schema.json#/$defs/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
