{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiltyparty.example/contracts/control-plane/v1/control-plane.schema.json",
  "title": "Guilty Party control plane protocol 1.0",
  "description": "Canonical payload and WebSocket envelope schemas. Unknown optional object members are allowed for additive compatibility within major version 1.",
  "$defs": {
    "ProtocolVersion": {
      "type": "string",
      "const": "1.0"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "MessageIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "FeatureIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "GameplayLanguage": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "description": "A gameplay-language tag in the supported BCP 47 structural subset. It is distinct from interface, caption, and communication languages."
    },
    "ClientBuild": {
      "type": "object",
      "required": ["application_id", "application_version", "build_number"],
      "properties": {
        "application_id": {
          "$ref": "#/$defs/FeatureIdentifier",
          "description": "A coarse first-party application identifier, not an installation or hardware identifier."
        },
        "application_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
        },
        "build_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "description": "Coarse compatibility metadata used for supported-build admission. It never grants authority and must not identify a physical installation."
    },
    "Token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "writeOnly": true,
      "description": "Opaque authority credential. Never log or place in WebSocket application envelopes."
    },
    "EndpointRegistration": {
      "type": "object",
      "required": ["platform", "capabilities"],
      "properties": {
        "platform": {
          "$ref": "#/$defs/FeatureIdentifier",
          "description": "A coarse client platform identifier, not a hardware or tracking identifier."
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/FeatureIdentifier"
          },
          "description": "Endpoint claims for server validation and routing; claims do not grant authority."
        },
        "client_build": {
          "$ref": "#/$defs/ClientBuild",
          "description": "Optional during pre-client migration. External-test environments require an approved build policy."
        }
      }
    },
    "SessionEndpointRecord": {
      "type": "object",
      "required": [
        "endpoint_id",
        "audience",
        "participant_id",
        "display_name",
        "platform",
        "capabilities",
        "authority_generation",
        "revoked"
      ],
      "properties": {
        "endpoint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "audience": {
          "type": "string",
          "pattern": "^(host|stage|participant)$"
        },
        "participant_id": {
          "oneOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "display_name": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
            },
            { "type": "null" }
          ]
        },
        "platform": {
          "$ref": "#/$defs/FeatureIdentifier"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/FeatureIdentifier"
          }
        },
        "authority_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "description": "Host-only operational endpoint metadata. It is not scenario truth and contains no private gameplay content or credentials."
    },
    "SessionEndpointRosterResponse": {
      "type": "object",
      "required": ["protocol_version", "endpoints"],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionEndpointRecord"
          }
        }
      }
    },
    "SessionAuthorityContextResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "session_id",
        "endpoint_id",
        "audience",
        "participant_id",
        "primary_authority_generation",
        "authority_expires_at_unix_ms"
      ],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "session_id": { "$ref": "#/$defs/Identifier" },
        "endpoint_id": { "$ref": "#/$defs/Identifier" },
        "audience": {
          "type": "string",
          "pattern": "^(host|stage|participant)$"
        },
        "participant_id": {
          "oneOf": [
            { "$ref": "#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "primary_authority_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "description": "Current validated endpoint context used to recover a browser session after reload. It contains no credential or gameplay projection."
    },
    "CompatibilityResponse": {
      "type": "object",
      "required": [
        "supported_protocol_majors",
        "preferred_protocol_version",
        "required_upgrade",
        "features"
      ],
      "properties": {
        "supported_protocol_majors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          }
        },
        "preferred_protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "required_upgrade": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/FeatureIdentifier"
          }
        }
      }
    },
    "JoinRequest": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "protocol_version",
            "kind",
            "display_name",
            "endpoint"
          ],
          "properties": {
            "protocol_version": {
              "$ref": "#/$defs/ProtocolVersion"
            },
            "kind": {
              "const": "participant"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
            },
            "endpoint": {
              "$ref": "#/$defs/EndpointRegistration"
            }
          }
        },
        {
          "type": "object",
          "required": ["protocol_version", "kind", "endpoint"],
          "properties": {
            "protocol_version": {
              "$ref": "#/$defs/ProtocolVersion"
            },
            "kind": {
              "const": "stage"
            },
            "display_name": {
              "type": "null"
            },
            "endpoint": {
              "$ref": "#/$defs/EndpointRegistration"
            }
          }
        }
      ]
    },
    "ParticipantResumeRequest": {
      "type": "object",
      "required": [
        "protocol_version",
        "session_id",
        "endpoint_id",
        "participant_id",
        "last_server_sequence",
        "primary_authority_generation",
        "pending_idempotency_ids",
        "client_build"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "endpoint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "participant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "last_server_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "primary_authority_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pending_idempotency_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/MessageIdentifier"
          },
          "description": "Opaque identifiers of commands whose outcome was unknown when the prior process stopped. No command or private-choice content is persisted here."
        },
        "client_build": {
          "$ref": "#/$defs/ClientBuild"
        }
      },
      "description": "Same-installation participant recovery metadata. The current credential is carried only in Authorization and the durably staged replacement only in X-GP-Replacement-Resume; neither is part of this payload."
    },
    "ResumedCommandStatus": {
      "oneOf": [
        {
          "$ref": "#/$defs/ResumedAcceptedCommandStatus"
        },
        {
          "$ref": "#/$defs/ResumedRejectedCommandStatus"
        },
        {
          "$ref": "#/$defs/ResumedUnknownCommandStatus"
        }
      ],
      "description": "Minimal recovery status for an opaque pending command identifier. It contains no command payload or private choice."
    },
    "ResumedAcceptedCommandStatus": {
      "type": "object",
      "required": ["idempotency_id", "status", "server_sequence"],
      "properties": {
        "idempotency_id": {
          "$ref": "#/$defs/MessageIdentifier"
        },
        "status": {
          "const": "accepted"
        },
        "server_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ResumedRejectedCommandStatus": {
      "type": "object",
      "required": ["idempotency_id", "status", "server_sequence"],
      "properties": {
        "idempotency_id": {
          "$ref": "#/$defs/MessageIdentifier"
        },
        "status": {
          "const": "rejected"
        },
        "server_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ResumedUnknownCommandStatus": {
      "type": "object",
      "required": ["idempotency_id", "status", "server_sequence"],
      "properties": {
        "idempotency_id": {
          "$ref": "#/$defs/MessageIdentifier"
        },
        "status": {
          "const": "unknown"
        },
        "server_sequence": {
          "type": "null"
        }
      }
    },
    "CreateSessionRequest": {
      "type": "object",
      "required": ["protocol_version", "endpoint"],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "gameplay_language": {
          "$ref": "#/$defs/GameplayLanguage",
          "description": "Omission during the protocol-v1 migration means en."
        },
        "endpoint": {
          "$ref": "#/$defs/EndpointRegistration"
        }
      }
    },
    "CreateSessionResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "session_id",
        "endpoint_id",
        "room_id",
        "authority_transport",
        "pairing_code",
        "pairing_expires_at_unix_ms",
        "session_expires_at_unix_ms",
        "maximum_participants"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "endpoint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "room_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authority_transport": {
          "const": "cookie"
        },
        "gameplay_language": {
          "$ref": "#/$defs/GameplayLanguage",
          "description": "New servers emit this field; compatible older senders may omit it, which means en."
        },
        "pairing_code": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128,
          "description": "Short-lived invitation proof. Never place in a URL, log, or persistent browser storage."
        },
        "invitation_payload": {
          "$ref": "#/$defs/InvitationPayload"
        },
        "pairing_expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "session_expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximum_participants": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        }
      }
    },
    "InvitationPayload": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1024,
      "pattern": "^GP1\\.[A-Za-z0-9_-]+$",
      "description": "A short-lived, non-URL QR/copy transfer payload containing an invitation proof. Keep only in memory and never log it."
    },
    "InvitationTransfer": {
      "type": "object",
      "required": [
        "version",
        "session_id",
        "pairing_code",
        "expires_at_unix_ms",
        "gameplay_language"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "pairing_code": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128,
          "writeOnly": true
        },
        "expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "gameplay_language": {
          "$ref": "#/$defs/GameplayLanguage",
          "description": "The language advertised with this invitation."
        }
      },
      "description": "Decoded GP1 invitation transfer content. The encoded payload is not a URL, authority, or durable invitation record."
    },
    "StagePairingCode": {
      "type": "string",
      "pattern": "^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$",
      "description": "A non-secret display code that locates a pending Stage pairing. It never grants authority."
    },
    "StagePairingCreateRequest": {
      "type": "object",
      "required": ["protocol_version", "endpoint"],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "endpoint": {
          "$ref": "#/$defs/EndpointRegistration"
        }
      }
    },
    "StagePairingCreateResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "pairing_code",
        "polling_secret",
        "redeem_path",
        "expires_at_unix_ms",
        "poll_after_ms"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "pairing_code": {
          "$ref": "#/$defs/StagePairingCode"
        },
        "polling_secret": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "writeOnly": true,
          "description": "High-entropy redemption secret kept only in packaged Stage process memory."
        },
        "redeem_path": {
          "type": "string",
          "pattern": "^/api/v1/stage-pairings/[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}/redeem$"
        },
        "expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "poll_after_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        }
      }
    },
    "StagePairingApprovalResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "action",
        "pairing_code",
        "status",
        "duplicate",
        "expires_at_unix_ms"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "action": {
          "const": "approve_stage_pairing"
        },
        "pairing_code": {
          "$ref": "#/$defs/StagePairingCode"
        },
        "status": {
          "const": "approved"
        },
        "duplicate": {
          "type": "boolean"
        },
        "expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "StagePairingPendingResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "status",
        "expires_at_unix_ms",
        "retry_after_ms"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "status": {
          "const": "pending"
        },
        "expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 10000
        }
      }
    },
    "RotateInvitationResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "action",
        "pairing_code",
        "pairing_expires_at_unix_ms"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "action": {
          "const": "rotate_invitation"
        },
        "pairing_code": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        },
        "invitation_payload": {
          "$ref": "#/$defs/InvitationPayload"
        },
        "pairing_expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "SessionControlResponseBase": {
      "type": "object",
      "required": ["protocol_version"],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      }
    },
    "CloseInvitationResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/SessionControlResponseBase"
        },
        {
          "type": "object",
          "required": ["action"],
          "properties": {
            "action": {
              "const": "close_invitation"
            }
          }
        }
      ]
    },
    "RevokeEndpointResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/SessionControlResponseBase"
        },
        {
          "type": "object",
          "required": ["action", "duplicate"],
          "properties": {
            "action": {
              "const": "revoke_endpoint"
            },
            "duplicate": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "EndSessionResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/SessionControlResponseBase"
        },
        {
          "type": "object",
          "required": ["action", "delete_at_unix_ms"],
          "properties": {
            "action": {
              "const": "end_session"
            },
            "delete_at_unix_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
    "SessionControlResponse": {
      "oneOf": [
        {
          "$ref": "#/$defs/CloseInvitationResponse"
        },
        {
          "$ref": "#/$defs/RevokeEndpointResponse"
        },
        {
          "$ref": "#/$defs/EndSessionResponse"
        }
      ]
    },
    "JoinResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "token",
        "session_id",
        "endpoint_id",
        "room_id",
        "participant_id"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "token": {
          "$ref": "#/$defs/Token"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "endpoint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "room_id": {
          "$ref": "#/$defs/Identifier"
        },
        "participant_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for a Stage join; an opaque participant identifier for a participant join."
        }
      }
    },
    "RemoteBearerJoinResponseBase": {
      "allOf": [
        {
          "$ref": "#/$defs/JoinResponse"
        },
        {
          "type": "object",
          "required": [
            "authority_transport",
            "authority_expires_at_unix_ms",
            "primary_authority_generation"
          ],
          "properties": {
            "authority_transport": {
              "type": "string",
              "pattern": "^bearer$"
            },
            "authority_expires_at_unix_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "primary_authority_generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
    "RemoteNativeJoinResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/RemoteBearerJoinResponseBase"
        },
        {
          "type": "object",
          "required": [
            "websocket_transport",
            "resume_token",
            "resume_expires_at_unix_ms",
            "server_sequence"
          ],
          "properties": {
            "websocket_transport": {
              "const": "authorization_header"
            },
            "resume_token": {
              "$ref": "#/$defs/Token",
              "description": "Rotating endpoint-bound participant resume credential for device-only native storage."
            },
            "resume_expires_at_unix_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "server_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
    "RemoteNativeResumeResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "token",
        "resume_token",
        "session_id",
        "endpoint_id",
        "room_id",
        "participant_id",
        "authority_transport",
        "websocket_transport",
        "authority_expires_at_unix_ms",
        "resume_expires_at_unix_ms",
        "primary_authority_generation",
        "server_sequence",
        "pending_command_results"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "token": {
          "$ref": "#/$defs/Token"
        },
        "resume_token": {
          "$ref": "#/$defs/Token",
          "description": "Confirmation of the client-generated replacement endpoint-bound resume credential that was durably staged before the request."
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "endpoint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "room_id": {
          "$ref": "#/$defs/Identifier"
        },
        "participant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "authority_transport": {
          "const": "bearer"
        },
        "websocket_transport": {
          "const": "authorization_header"
        },
        "authority_expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resume_expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "primary_authority_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "server_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pending_command_results": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ResumedCommandStatus"
          }
        }
      },
      "description": "Rotated same-installation participant authority. A fresh recipient projection is still required before private content or actions return."
    },
    "RemotePackagedStageJoinResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/RemoteBearerJoinResponseBase"
        },
        {
          "type": "object",
          "required": ["websocket_transport", "websocket_ticket_endpoint"],
          "properties": {
            "websocket_transport": {
              "const": "ticket_subprotocol"
            },
            "websocket_ticket_endpoint": {
              "type": "string",
              "pattern": "^/api/v1/websocket-tickets$"
            }
          }
        }
      ]
    },
    "RemoteBrowserJoinResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "session_id",
        "endpoint_id",
        "room_id",
        "participant_id",
        "authority_transport",
        "websocket_transport",
        "authority_expires_at_unix_ms",
        "primary_authority_generation"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "endpoint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "room_id": {
          "$ref": "#/$defs/Identifier"
        },
        "participant_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for a Stage join; an opaque participant identifier for a participant join."
        },
        "authority_transport": {
          "type": "string",
          "pattern": "^cookie$",
          "description": "Browser authority is delivered as Secure, HttpOnly, SameSite=Strict."
        },
        "websocket_transport": {
          "const": "cookie"
        },
        "authority_expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "primary_authority_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "RemoteFriendsJoinResponse": {
      "oneOf": [
        {
          "$ref": "#/$defs/RemoteNativeJoinResponse"
        },
        {
          "$ref": "#/$defs/RemotePackagedStageJoinResponse"
        },
        {
          "$ref": "#/$defs/RemoteBrowserJoinResponse"
        }
      ]
    },
    "RealtimeConnectTicketResponse": {
      "type": "object",
      "required": [
        "protocol_version",
        "websocket_subprotocol",
        "ticket_expires_at_unix_ms"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "websocket_subprotocol": {
          "$ref": "#/$defs/Token",
          "description": "Short-lived, single-use packaged Stage credential offered alongside the control WebSocket subprotocol."
        },
        "ticket_expires_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "ErrorBody": {
      "type": "object",
      "required": ["code", "title"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "detail": {
          "type": "string",
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "ProblemDetails": {
      "type": "object",
      "required": [
        "protocol_version",
        "type",
        "title",
        "status",
        "code",
        "correlation_id"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "format": "uri-reference"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "maxLength": 1000
        },
        "instance": {
          "type": "string",
          "format": "uri-reference"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "correlation_id": {
          "$ref": "#/$defs/MessageIdentifier"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "AssignCharacterCommand": {
      "type": "object",
      "required": ["type", "participant_id", "character_id"],
      "properties": {
        "type": {
          "const": "assign_character"
        },
        "participant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "character_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "AdvanceSceneCommand": {
      "type": "object",
      "required": ["type", "scene_id"],
      "properties": {
        "type": {
          "const": "advance_scene"
        },
        "scene_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "RevealClueCommand": {
      "type": "object",
      "required": ["type", "clue_id"],
      "properties": {
        "type": {
          "const": "reveal_clue"
        },
        "clue_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "OpenVotingCommand": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "open_voting"
        }
      }
    },
    "CastVoteCommand": {
      "type": "object",
      "required": ["type", "target_character_id"],
      "properties": {
        "type": {
          "const": "cast_vote"
        },
        "target_character_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "CloseVotingCommand": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "close_voting"
        }
      }
    },
    "ClientCommand": {
      "oneOf": [
        {
          "$ref": "#/$defs/AssignCharacterCommand"
        },
        {
          "$ref": "#/$defs/AdvanceSceneCommand"
        },
        {
          "$ref": "#/$defs/RevealClueCommand"
        },
        {
          "$ref": "#/$defs/OpenVotingCommand"
        },
        {
          "$ref": "#/$defs/CastVoteCommand"
        },
        {
          "$ref": "#/$defs/CloseVotingCommand"
        }
      ]
    },
    "EnvelopeContext": {
      "type": "object",
      "required": ["protocol_version", "type", "message_id", "payload"],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message_id": {
          "$ref": "#/$defs/MessageIdentifier"
        },
        "correlation_id": {
          "$ref": "#/$defs/MessageIdentifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "endpoint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "idempotency_id": {
          "$ref": "#/$defs/MessageIdentifier"
        },
        "primary_authority_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "server_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "GetProjectionEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/EnvelopeContext"
        },
        {
          "type": "object",
          "required": ["session_id", "endpoint_id"],
          "properties": {
            "type": {
              "const": "get_projection"
            },
            "payload": {
              "type": "object"
            }
          }
        }
      ]
    },
    "RequestAiSuggestionEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/EnvelopeContext"
        },
        {
          "type": "object",
          "required": ["session_id", "endpoint_id"],
          "properties": {
            "type": {
              "const": "request_ai_suggestion"
            },
            "payload": {
              "type": "object"
            }
          }
        }
      ]
    },
    "SubmitCommandEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/EnvelopeContext"
        },
        {
          "type": "object",
          "required": [
            "session_id",
            "endpoint_id",
            "idempotency_id",
            "primary_authority_generation"
          ],
          "properties": {
            "type": {
              "const": "submit_command"
            },
            "payload": {
              "type": "object",
              "required": ["command"],
              "properties": {
                "command": {
                  "$ref": "#/$defs/ClientCommand"
                }
              }
            }
          }
        }
      ]
    },
    "ClientEnvelope": {
      "oneOf": [
        {
          "$ref": "#/$defs/GetProjectionEnvelope"
        },
        {
          "$ref": "#/$defs/RequestAiSuggestionEnvelope"
        },
        {
          "$ref": "#/$defs/SubmitCommandEnvelope"
        }
      ]
    },
    "ProjectedScene": {
      "type": "object",
      "required": ["id", "name", "public_narrative"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string"
        },
        "public_narrative": {
          "type": "string"
        }
      }
    },
    "ProjectedClue": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "ProjectedParticipant": {
      "type": "object",
      "required": ["participant_id", "name", "character_name"],
      "properties": {
        "participant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "character_name": {
          "type": ["string", "null"]
        },
        "private_objective": {
          "type": "string",
          "description": "Absent unless authorized for this recipient. Never represented as null."
        },
        "has_voted": {
          "type": "boolean",
          "description": "Absent unless authorized for this recipient."
        }
      }
    },
    "ProjectedOutcome": {
      "type": "object",
      "required": ["id", "public_resolution"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "public_resolution": {
          "type": "string"
        }
      }
    },
    "AuthorizedProjection": {
      "type": "object",
      "required": [
        "scenario_id",
        "scenario_version",
        "scenario_title",
        "active_scene",
        "revealed_clues",
        "participants",
        "voting_open",
        "votes_cast",
        "outcome"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/Identifier"
        },
        "scenario_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "scenario_title": {
          "type": "string"
        },
        "gameplay_language": {
          "$ref": "#/$defs/GameplayLanguage",
          "description": "New servers emit this field; compatible older senders may omit it, which means en."
        },
        "active_scene": {
          "oneOf": [
            {
              "$ref": "#/$defs/ProjectedScene"
            },
            {
              "type": "null"
            }
          ]
        },
        "revealed_clues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectedClue"
          }
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectedParticipant"
          }
        },
        "voting_open": {
          "type": "boolean"
        },
        "votes_cast": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "oneOf": [
            {
              "$ref": "#/$defs/ProjectedOutcome"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProjectionEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/EnvelopeContext"
        },
        {
          "type": "object",
          "required": ["session_id", "endpoint_id", "server_sequence"],
          "properties": {
            "type": {
              "const": "projection"
            },
            "payload": {
              "type": "object",
              "required": ["projection"],
              "properties": {
                "projection": {
                  "$ref": "#/$defs/AuthorizedProjection"
                }
              }
            }
          }
        }
      ]
    },
    "AiSuggestionEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/EnvelopeContext"
        },
        {
          "type": "object",
          "required": ["correlation_id", "session_id", "endpoint_id"],
          "properties": {
            "type": {
              "const": "ai_suggestion"
            },
            "payload": {
              "type": "object",
              "required": ["suggestion"],
              "properties": {
                "suggestion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          }
        }
      ]
    },
    "CommandResultBody": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "idempotency_id",
            "status",
            "primary_authority_generation"
          ],
          "properties": {
            "idempotency_id": {
              "$ref": "#/$defs/MessageIdentifier"
            },
            "status": {
              "const": "accepted"
            },
            "primary_authority_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "required": [
            "idempotency_id",
            "status",
            "primary_authority_generation",
            "code",
            "title"
          ],
          "properties": {
            "idempotency_id": {
              "$ref": "#/$defs/MessageIdentifier"
            },
            "status": {
              "const": "rejected"
            },
            "primary_authority_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      ]
    },
    "CommandResultEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/EnvelopeContext"
        },
        {
          "type": "object",
          "required": [
            "correlation_id",
            "session_id",
            "endpoint_id",
            "server_sequence"
          ],
          "properties": {
            "type": {
              "const": "command_result"
            },
            "payload": {
              "$ref": "#/$defs/CommandResultBody"
            }
          }
        }
      ]
    },
    "ErrorEnvelope": {
      "allOf": [
        {
          "$ref": "#/$defs/EnvelopeContext"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "error"
            },
            "payload": {
              "$ref": "#/$defs/ErrorBody"
            }
          }
        }
      ]
    },
    "ServerEnvelope": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProjectionEnvelope"
        },
        {
          "$ref": "#/$defs/AiSuggestionEnvelope"
        },
        {
          "$ref": "#/$defs/CommandResultEnvelope"
        },
        {
          "$ref": "#/$defs/ErrorEnvelope"
        }
      ]
    }
  }
}
